<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- WITHOUT these, checkStorage/requestLegacyStorage can never succeed:
         Android silently denies undeclared permissions, so every shared
         folder keeps failing with os error 13 no matter what the UI does.
         Values match the app manifest to avoid merger conflicts. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
</manifest>
